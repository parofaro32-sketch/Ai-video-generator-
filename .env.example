# Database (PostgreSQL, compatible with Vercel Postgres/Neon/Supabase)
# Required for sign-up, auth, jobs, history, and storage metadata.
# Vercel Postgres users: connecting the integration usually provides POSTGRES_PRISMA_URL (and others);
# this app auto-detects POSTGRES_PRISMA_URL/POSTGRES_URL if DATABASE_URL is not set, but setting DATABASE_URL is recommended.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Auth/session secret (generate a long random string)
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Vercel Blob storage for generated videos/thumbnails (recommended on Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: Hugging Face token for accessing spaces with higher quota where permitted (server-side only)
# HF_TOKEN="hf_..."

# App URL (optional)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
